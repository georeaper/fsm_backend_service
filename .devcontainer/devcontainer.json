{
  "name": "Ktor Kotlin Dev",

  "dockerComposeFile": "docker-compose.yml",

  "service": "app",

  "workspaceFolder": "/workspaces/fsm_backend_service",

  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-java-pack"
      ]
    }
  },

  "forwardPorts": [8080, 5432],

  "postCreateCommand": ".devcontainer/init-env.sh && ./gradlew build"
}