{
  "name": "Ktor Kotlin Dev",
  "image": "mcr.microsoft.com/devcontainers/java:21",

  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-java-pack"
      ]
    }
  },

  "postCreateCommand": "./gradlew build",
  "forwardPorts": [8080],

  "portsAttributes": {
    "8080": {
      "label": "Ktor App",
      "onAutoForward": "openBrowser"
    }
  }
}